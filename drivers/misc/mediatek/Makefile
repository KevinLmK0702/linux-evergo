# The gen4m WLAN driver brings its own vendor-style Makefile that is driven
# by a set of plain make variables (WLAN_CHIP_ID, MTK_COMBO_CHIP,
# CONFIG_MTK_COMBO_WIFI_HIF, ...) rather than by Kconfig symbols.  They are
# exported here so the nested invocation of scripts/Makefile.build for
# connectivity/wlan/... inherits them.
#
obj-$(CONFIG_MTK_GEN4M_WIFI) += connectivity/
